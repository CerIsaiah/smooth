# SmoothRizz environment variables
#
# BUILD-REQUIRED (4): these are read at module scope in API routes (Stripe and
# Supabase clients are instantiated when the route module loads), so `next build`
# evaluates them while compiling/prerendering. Placeholders below are enough
# for a local build.
#
# RUNTIME-ONLY (4): read during request handling or in the browser; the app
# builds and runs without them, but features depending on them will not work.

# ---- Build-required ----

# Server-side Stripe client (module-scope instantiation in API routes)
STRIPE_SECRET_KEY=sk_test_placeholder

# Supabase PostgREST project URL (module-scope client instantiation)
SUPABASE_URL=https://placeholder.supabase.co

# Supabase service-role key (module-scope client instantiation; server-only)
SUPABASE_SERVICE_ROLE_KEY=placeholder

# OpenAI API key for the fine-tuned response-generation model
# (module-scope client instantiation in src/app/openai.js; also used at runtime)
OPENAI_API_KEY=sk-placeholder

# ---- Runtime-only ----

# Google OAuth client ID served to the browser via /api/auth/google-client-id
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com

# Secret used to verify Stripe webhook signatures (src/app/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Publishable key for client-side Stripe (loadStripe on the home page)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Absolute base URL used to build absolute links server-side
NEXT_PUBLIC_BASE_URL=https://www.smoothrizz.com
